  "formulas": [
    {
      "formulaId": "FORM-CALA-PUNTA",
      "title": "Adicionales de punta de cala",
      "expression": "puntos por tiempos + metros válidos por encima de seis, sujeto a requisitos reglamentarios.",
      "status": "OFFICIAL_REGULATION",
      "references": [
        "Reglamento 2026, art. 94 y Calificaciones de Cala, p. 38"
      ],
      "implementationStatus": "REQUIRES_FULL_CONDITION_CATALOG"
    },
    {
      "formulaId": "FORM-CALA-BAD-POINTS",
      "title": "Suma puntos malos de Cala",
      "expression": "SUM(casillas de malos aplicables).",
      "status": "PENDING_VALIDATION",
      "references": [
        "Formato oficial: ocho casillas y TOTAL MALOS, sin catálogo por casilla."
      ],
      "implementationStatus": "BLOCKED"
    },
    {
      "formulaId": "FORM-CALA-PARTIAL",
      "title": "Puntos parciales de Cala",
      "expression": "Subtotal de componentes de Cala antes del cierre de sección.",
      "status": "SPORTS_INFERENCE",
      "references": [
        "Formato oficial y Reglamento 2026, pp. 38-43."
      ],
      "implementationStatus": "BLOCKED_PENDING_JUDGE_CONFIRMATION"
    },
    {
      "formulaId": "FORM-CALA-SECTION",
      "title": "Total de Cala",
      "expression": "base + adicionales validados - infracciones validadas - infracción de equipo aplicable.",
      "status": "SPORTS_INFERENCE",
      "references": [
        "Reglamento 2026, p. 38; formato oficial."
      ],
      "implementationStatus": "BLOCKED_PENDING_ABBREVIATION_MAPPING"
    },
    {
      "formulaId": "FORM-OPPORTUNITY-NET",
      "title": "Total neto de oportunidad o pasada",
      "expression": "BUENO - MALOS de la misma oportunidad o pasada.",
      "status": "SPORTS_INFERENCE",
      "references": [
        "Formato oficial: BUENO, MALOS y TOTAL; capítulo de la suerte."
      ],
      "implementationStatus": "BLOCKED_PENDING_FORMULA_CERTIFICATION"
    },
    {
      "formulaId": "FORM-PIALES-SECTION",
      "title": "Total de Piales",
      "expression": "SUM(tres oportunidades) más componentes certificables de tiempo e infracción.",
      "status": "SPORTS_INFERENCE",
      "references": [
        "Reglamento 2026, arts. 95-110, pp. 45-49."
      ],
      "implementationStatus": "BLOCKED_PENDING_T_COLUMN_CONFIRMATION"
    },
    {
      "formulaId": "FORM-COLEADERO-SECTION",
      "title": "Total de Coleadero",
      "expression": "Agregación de pasadas y participantes según topología oficial.",
      "status": "PENDING_VALIDATION",
      "references": [
        "Reglamento 2026, arts. 111-133; formato oficial."
      ],
      "implementationStatus": "BLOCKED"
    },
    {
      "formulaId": "FORM-JINETEO-PARTIAL",
      "title": "Subtotal de Jineteo",
      "expression": "base de clasificación + adicionales de tabla aplicable.",
      "status": "OFFICIAL_REGULATION",
      "references": [
        "Toro p. 59; Yegua p. 77 del Reglamento 2026."
      ],
      "implementationStatus": "REQUIRES_TABLE_ENCODING"
    },
    {
      "formulaId": "FORM-JINETEO-FINAL",
      "title": "Total final de Jineteo",
      "expression": "subtotal - malos + T o tiempo cuando su vínculo sea confirmado.",
      "status": "SPORTS_INFERENCE",
      "references": [
        "Reglamento 2026, pp. 59 y 77; formato oficial."
      ],
      "implementationStatus": "BLOCKED_PENDING_T_COLUMN_CONFIRMATION"
    },
    {
      "formulaId": "FORM-TERNA-ROW",
      "title": "Total de fila de Terna",
      "expression": "base/adicionales + remate - malos + T, con asignación pendiente por participante.",
      "status": "PENDING_VALIDATION",
      "references": [
        "Reglamento 2026, arts. 149-170; formato oficial."
      ],
      "implementationStatus": "BLOCKED"
    },
    {
      "formulaId": "FORM-MANGANAS-SECTION",
      "title": "Total de Manganas",
      "expression": "SUM(tres oportunidades) + T o tiempo si se certifica - infracciones.",
      "status": "SPORTS_INFERENCE",
      "references": [
        "Reglamento 2026, arts. 186-217, pp. 81-92."
      ],
      "implementationStatus": "BLOCKED_PENDING_T_COLUMN_CONFIRMATION"
    },
    {
      "formulaId": "FORM-PASO-SECTION",
      "title": "Total de Paso",
      "expression": "base de vuelta + adicionales aplicables - malos - infracciones.",
      "status": "SPORTS_INFERENCE",
      "references": [
        "Reglamento 2026, arts. 218-239, pp. 93-100."
      ],
      "implementationStatus": "BLOCKED_PENDING_COLUMN_MAPPING"
    },
    {
      "formulaId": "FORM-CLOSING-BAD-POINTS",
      "title": "TOTAL, PUNTOS MALOS",
      "expression": "Agregación de puntos malos por reglas aprobadas.",
      "status": "PENDING_VALIDATION",
      "references": [
        "Formato oficial, celda de cierre sin operador."
      ],
      "implementationStatus": "BLOCKED"
    },
    {
      "formulaId": "FORM-CLOSING-FINAL",
      "title": "PUNTUACIÓN FINAL",
      "expression": "Total oficial de hoja después de todas las reglas autorizadas.",
      "status": "PENDING_VALIDATION",
      "references": [
        "Formato oficial y Reglamento 2026, sin fórmula de cierre vinculada."
      ],
      "implementationStatus": "BLOCKED"
    }
  ],
